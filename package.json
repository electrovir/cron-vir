{
    "name": "cron-vir",
    "version": "0.0.1",
    "description": "A declarative cron function runner.",
    "keywords": [
        "cron",
        "declarative"
    ],
    "homepage": "https://github.com/electrovir/cron-vir",
    "bugs": {
        "url": "https://github.com/electrovir/cron-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/cron-vir.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "tsx src/demo.mock.ts",
        "test": "virmator test node",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,docs,deps,lint \"npm run test:coverage\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.27.0",
        "@augment-vir/common": "^31.27.0",
        "cron-parser": "^5.3.0",
        "date-vir": "^7.3.2",
        "type-fest": "^4.41.0",
        "typed-event-target": "^4.1.0"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.27.0",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.30.1",
        "@stylistic/eslint-plugin": "^5.1.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^22.15.30",
        "@typescript-eslint/eslint-plugin": "^8.36.0",
        "c8": "^10.1.3",
        "cspell": "^9.1.3",
        "dependency-cruiser": "^16.10.4",
        "esbuild": "^0.25.6",
        "eslint": "^9.30.1",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-jsdoc": "^51.3.4",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.2.0",
        "eslint-plugin-prettier": "^5.5.1",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.4",
        "eslint-plugin-unicorn": "^59.0.1",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^18.0.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.3.3",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-packagejson": "^2.5.18",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.5",
        "typedoc": "^0.28.7",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.36.0",
        "virmator": "^13.15.5"
    },
    "engines": {
        "node": ">=22"
    }
}
